---
import Base from '../layouts/Base.astro';
import { trabajos } from '../data/trabajos';
---
<Base>
  <main id="contenido">
    <section class="hero wrap" aria-labelledby="titulo">
      <div class="hero-copy">
        <p class="eyebrow">SITIO PERSONAL · SANTIAGO MARTÍNEZ</p>
        <h1 id="titulo">Aprender.<br />Construir.<br /><span>Compartir.</span></h1>
        <p class="intro">Un espacio para mis trabajos, ideas y proyectos. Hoy, un recorrido por la cursada de Ingeniería de Requerimientos.</p>
        <a class="button" href="#cursada">Explorar la cursada</a>
      </div>
      <aside class="course-cover" aria-label="Colección de trabajos de Ingeniería de Requerimientos">
        <div class="cover-top"><span>CUADERNO DE CURSADA</span><span>2026</span></div>
        <div class="cover-art" aria-hidden="true"><div class="circle circle-one"></div><div class="circle circle-two"></div><div class="circle circle-three"></div><div class="cross cross-one">+</div><div class="cross cross-two">+</div></div>
        <div class="cover-title">Ingeniería de<br />Requerimientos</div>
        <div class="cover-bottom"><span>Del problema a la especificación</span><span>IR</span></div>
      </aside>
    </section>
    <section id="cursada" class="course-section">
      <div class="wrap">
        <div class="section-intro"><div><p class="eyebrow">ARCHIVO ACADÉMICO</p><h2>La cursada, en trabajos.</h2></div><p>Ejercitaciones, reseñas y trabajos integrados.<br />Cada documento, disponible para descargar.</p></div>
        <div class="filters" role="group" aria-label="Filtrar trabajos" hidden><button data-filter="Todos" aria-pressed="true">Todos <span>6</span></button><button data-filter="Ejercitación" aria-pressed="false">Ejercitaciones</button><button data-filter="Reseña" aria-pressed="false">Reseñas</button><button data-filter="Trabajo práctico" aria-pressed="false">Integrados</button></div>
        <p id="resultados" class="sr-only" aria-live="polite"></p>
        <div class="works">
          {trabajos.map(t=>(<article class="work" data-tipo={t.tipo}><div class="work-class"><span>{t.clase}</span><small>{t.tipo}</small></div><div class="work-copy"><h3>{t.titulo}</h3><p>{t.descripcion}</p></div><a class="download" href={'/documentos/'+t.archivo} download aria-label={'Descargar '+t.titulo+' en Word'}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7 3h7l4 4v14H7zM14 3v5h4M10 12h5M10 16h5" /></svg><span>Descargar Word<small>DOCX</small></span></a></article>))}
        </div>
      </div>
    </section>
    <section id="sobre-mi" class="about wrap"><p class="eyebrow">SOBRE MÍ</p><div><h2>Soy Santiago Martínez.</h2><p>Este sitio reúne mis trabajos de Ingeniería de Requerimientos y es el punto de partida para compartir mis próximos proyectos.</p><a class="text-link" href="https://github.com/SJMartinez">Encontrame en GitHub</a></div></section>
  </main>
  <script>
    const filters = document.querySelector<HTMLElement>('.filters');
    if(filters) filters.hidden=false;
    document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button=>{
      button.addEventListener('click',()=>{
        const chosen=button.dataset.filter;let visible=0;
        document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));
        document.querySelectorAll<HTMLElement>('.work').forEach(work=>{work.hidden=chosen!=='Todos'&&work.dataset.tipo!==chosen;if(!work.hidden)visible++;});
        const status=document.querySelector('#resultados');if(status)status.textContent=`${visible} trabajos disponibles`;
      });
    });
  </script>
</Base>
