---
import Base from '../layouts/Base.astro';
import { trabajos } from '../data/trabajos';
---
<Base>
  <main id="contenido">
    <section id="cursada" class="course-section">
      <div class="wrap">
        <div class="section-intro"><div><p class="eyebrow">CURSADA 2026</p><h1 class="course-title">Ingeniería de Requerimientos</h1></div><p>Trabajos prácticos para descargar.</p></div>
        <div class="filters" role="group" aria-label="Filtrar trabajos" hidden><button data-filter="Todos" aria-pressed="true">Todos <span>6</span></button><button data-filter="Ejercitación" aria-pressed="false">Ejercitaciones</button><button data-filter="Reseña" aria-pressed="false">Reseñas</button><button data-filter="Trabajo práctico" aria-pressed="false">Integrados</button></div>
        <p id="resultados" class="sr-only" aria-live="polite"></p>
        <div class="works">
          {trabajos.map(t=>(<article class="work" data-tipo={t.tipo}><div class="work-class"><span>{t.clase}</span><small>{t.tipo}</small></div><div class="work-copy"><h3>{t.titulo}</h3><p>{t.descripcion}</p></div><a class="download" href={'/documentos/'+t.archivo} download aria-label={'Descargar '+t.titulo+' en Word'}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7 3h7l4 4v14H7zM14 3v5h4M10 12h5M10 16h5" /></svg><span>Descargar Word<small>DOCX</small></span></a></article>))}
        </div>
      </div>
    </section>

  </main>
  <script>
    const filters = document.querySelector<HTMLElement>('.filters');
    if(filters) filters.hidden=false;
    document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button=>{
      button.addEventListener('click',()=>{
        const chosen=button.dataset.filter;let visible=0;
        document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));
        document.querySelectorAll<HTMLElement>('.work').forEach(work=>{work.hidden=chosen!=='Todos'&&work.dataset.tipo!==chosen;if(!work.hidden)visible++;});
        const status=document.querySelector('#resultados');if(status)status.textContent=`${visible} trabajos disponibles`;
      });
    });
  </script>
</Base>
